# Copy to keystore.properties (which is gitignored) and fill in.
# Never commit the real file or the keystore it points at.
#
# storeFile is resolved relative to the repository root. Keeping the keystore OUTSIDE the repo
# is the safer choice, e.g. ../lapse-release.jks or an absolute path.
storeFile=../lapse-release.jks
storePassword=
keyAlias=lapse
keyPassword=
