<?xml version="1.0" encoding="utf-8"?>
<!--
  API 30 and below, where cloud backup and device transfer cannot be configured separately.

  Photos are excluded outright, because "never uploaded" is a stated guarantee. The database and
  preferences are left backed up here: on these versions the alternative is allowBackup="false",
  which would also kill device transfer, and tracked dates surviving a lost phone is worth more
  than absolute locality for a shrinking set of devices. On API 31+ nothing is uploaded at all —
  see data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="file" path="photos" />
</full-backup-content>
