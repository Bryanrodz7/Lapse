<?xml version="1.0" encoding="utf-8"?>
<!-- Static preview for the widget picker; mirrors the real layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="@string/widget_preview_name"
        android:textColor="@color/widget_on_background"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="@string/widget_preview_days"
        android:textColor="@color/widget_preview_accent"
        android:textSize="34sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_label"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />
</LinearLayout>
