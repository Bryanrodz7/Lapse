<?xml version="1.0" encoding="utf-8"?>
<!--
  Fallback preview for pickers that do not use previewLayout (API 30 and below). A flat
  representation of the widget rather than a screenshot, so it stays correct if the layout moves.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_background" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:left="16dp"
        android:top="14dp"
        android:right="16dp"
        android:bottom="46dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_muted" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item
        android:left="16dp"
        android:top="34dp"
        android:right="70dp"
        android:bottom="18dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_preview_accent" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
