<?xml version="1.0" encoding="utf-8"?>
<!--
  A countdown dial: a disc whose last quarter is the app's urgent accent.

  Two sectors rather than a disc with a wedge drawn over it, so there is no overdraw and the
  seam stays crisp at small sizes. The mark is 60dp across inside the 108dp viewport, which
  keeps it within the 66dp guaranteed-visible area of the adaptive mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The 270 degrees still remaining, in paper. -->
    <path
        android:fillColor="#FAF7F2"
        android:pathData="M54,54 L84,54 A30,30 0 1 1 54,24 Z" />

    <!-- The last quarter, burnt orange: the part that is running out. -->
    <path
        android:fillColor="#B85529"
        android:pathData="M54,54 L54,24 A30,30 0 0 1 84,54 Z" />
</vector>
